#!/usr/bin/env bash

# Leonardo environment for the OGAS / Melissa stack (sourced by leo_melissa_init.sh).
_LEO_ENV_FILE="${BASH_SOURCE[0]}"
_LEO_ENV_DIR="$(cd "$(dirname "$_LEO_ENV_FILE")" && pwd)"
export OGAS_ROOT="${OGAS_ROOT:-$_LEO_ENV_DIR}"
export MELISSA_ROOT="${MELISSA_ROOT:-$OGAS_ROOT/melissa}"
export EXTERNAL_VAL_SCRIPT="${EXTERNAL_VAL_SCRIPT:-$OGAS_ROOT/ogas/validation/external_validator.py}"

# Optional overrides: MELISSA_ENV (virtual environment, default <repo>/.venv) and EXP_DIR (root of the
# configs and runs, default <repo>). Setting LEONARDO_PROJECT_ROOT keeps the historical venv location.
if [[ -n "${LEONARDO_PROJECT_ROOT:-}" ]]; then
    export MELISSA_ENV="${MELISSA_ENV:-$LEONARDO_PROJECT_ROOT/environment_base_editable}"
    export UV_CACHE_DIR="${UV_CACHE_DIR:-$LEONARDO_PROJECT_ROOT/.uv-cache}"
else
    export MELISSA_ENV="${MELISSA_ENV:-$OGAS_ROOT/.venv}"
fi
export EXP_DIR="${EXP_DIR:-$OGAS_ROOT}"
export WANDB_MODE="${WANDB_MODE:-offline}"

_leo_prepend_cuda_libs() {
    if [[ -d "$MELISSA_ENV/lib/python3.11/site-packages/nvidia" ]]; then
        for _leo_cuda_lib in "$MELISSA_ENV"/lib/python3.11/site-packages/nvidia/*/lib; do
            [[ -d "$_leo_cuda_lib" ]] || continue
            export LD_LIBRARY_PATH="$_leo_cuda_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        done
    fi
}

# Guard against re-execution
if [[ -n "${_OGAS_ENVRC_LOADED:-}" ]]; then
    _leo_prepend_cuda_libs
    return
fi
export _OGAS_ENVRC_LOADED=1

export PYTHONPATH="$OGAS_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export LD_LIBRARY_PATH="$MELISSA_ENV/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Torch wheels bring CUDA 12.8 libraries.  They must precede the system CUDA
# module (which may be 12.2) or libnvJitLink resolves to the wrong ABI.
_leo_prepend_cuda_libs
